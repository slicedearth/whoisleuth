{
  "name": "whoisleuth",
  "version": "1.47.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open-source, local-first domain intelligence and brand-protection console for WHOIS, RDAP, DNS, certificate transparency, lookalike domains, and web evidence.",
  "keywords": [
    "whois",
    "rdap",
    "dns",
    "domain-intelligence",
    "brand-protection",
    "typosquatting",
    "certificate-transparency",
    "osint",
    "threat-intelligence",
    "asn"
  ],
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "npm run build && node server.mts",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 --test-coverage-include=\"lib/**/*.mts\" --test-coverage-include=\"cli/**/*.mts\" --test-coverage-include=\"frontend/src/lib/**/*.ts\" --test-coverage-include=\"netlify/functions/**/*.mts\" --test-coverage-include=\"server.mts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test-coverage.lcov",
    "test:properties": "node --test test/core-protocol-properties.test.mts test/evidence-quality-properties.test.mts test/browser-library-profile.test.mts test/service-binding-dns.test.mts test/model-contract-properties.test.mts",
    "test:profile": "node --test --test-reporter=spec --test-reporter-destination=stderr --test-reporter=./tools/test-duration-reporter.mts --test-reporter-destination=stdout",
    "typecheck": "npm run sync --workspace=frontend && tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/analysis-tsconfig.json && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "check": "npm run check --workspace=frontend",
    "test:e2e": "playwright test",
    "test:e2e:journeys": "playwright test --grep @analyst-journey --workers=1 --retries=0",
    "test:e2e:built": "WHOISLEUTH_E2E_USE_BUILD=1 playwright test",
    "test:e2e:summary": "node tools/playwright-results-summary.mts",
    "test:e2e:stress": "playwright test --grep @timing-sensitive --workers=1 --retries=0 --repeat-each=10",
    "test:e2e:install": "playwright install --with-deps chromium",
    "capture:local": "node packages/web-capture/bin/whoisleuth-capture.mts",
    "capture:compare": "node packages/web-capture/bin/whoisleuth-capture.mts compare",
    "cli:package:check": "node tools/cli-package.mts",
    "cli:package:release": "node tools/cli-package.mts --release-candidate",
    "cli:package:verify-published": "node tools/published-cli-check.mts",
    "schema:inventory": "node tools/schema-inventory.mts",
    "stix:conformance": "node tools/stix-schema-conformance.mts",
    "deployment:self-check": "node tools/deployment-self-check.mts",
    "registry:drift": "node tools/registry-drift-audit.mts",
    "rdap-extensions:drift": "node tools/rdap-extension-drift-audit.mts",
    "registry:fixtures": "node tools/registry-fixture-freshness.mts",
    "registry:fixture-scaffold": "node tools/registry-fixture-scaffold.mts",
    "unicode:confusables": "node tools/unicode-confusable-audit.mts",
    "benchmark:technology": "node tools/technology-signature-benchmark.mts",
    "technology:coverage-check": "node tools/technology-signature-benchmark.mts --require-reviewed",
    "technology:signature-scaffold": "node tools/technology-signature-scaffold.mts",
    "technology:review-candidate": "node tools/technology-review-candidate.mts",
    "technology:fixture-review": "node tools/technology-fixture-review.mts",
    "technology:example-review": "node tools/technology-example-review.mts",
    "technology:source-verify": "node tools/technology-source-verify.mts",
    "accuracy:status": "node tools/reviewed-accuracy-status.mts",
    "accuracy:review-scaffold": "node tools/reviewed-accuracy-scaffold.mts",
    "service-dependencies:audit": "node tools/service-dependency-signature-audit.mts",
    "study:first-use": "node tools/first-use-analyst-study.mts",
    "journeys:synthetic": "node tools/synthetic-analyst-journeys.mts",
    "sslbl:snapshot": "node tools/sslbl-snapshot.mts",
    "sslbl:check": "node tools/sslbl-snapshot.mts --check-only",
    "sslbl:status": "node tools/sslbl-snapshot-status.mts",
    "common-infrastructure:update": "node tools/common-infrastructure-snapshot.mts",
    "common-infrastructure:check": "node tools/common-infrastructure-snapshot.mts --check-only",
    "lookup:transport-spike": "node tools/incremental-lookup-transport-spike.mts",
    "lookup:transport-qualify": "node tools/incremental-lookup-qualification.mts",
    "lookup:staging-evidence": "node tools/incremental-lookup-staging-evidence.mts",
    "frontend:loading-report": "node tools/frontend-loading-report.mts",
    "frontend:authenticated-loading-report": "playwright test e2e/console-loading.spec.ts --workers=1",
    "benchmark:workflow": "node tools/specialist-workflow-benchmark.mts",
    "platform:local-data": "node tools/local-data-platform-evaluation.mts",
    "catalog:retire": "node tools/retire-browser-catalog.mts",
    "catalog:kev": "node tools/cisa-kev-catalog.mts",
    "catalog:kev:status": "node tools/cisa-kev-catalog-status.mts",
    "architecture:check": "npm run sync --workspace=frontend && depcruise --config .dependency-cruiser.json --output-type err-long -- lib cli bin netlify/functions frontend/src packages tools server.mts",
    "release:check": "node tools/release-version-check.mts",
    "dependencies:audit": "node tools/production-dependency-audit.mts",
    "licenses:check": "node tools/third-party-notices.mts --check",
    "licenses:update": "node tools/third-party-notices.mts --write",
    "providers:policy-check": "node tools/provider-policy-freshness.mts",
    "security:codeql": "node tools/local-codeql.mts",
    "security:staged": "node tools/staged-secret-check.mts",
    "security:retire": "retire --path frontend/build --severity high --outputformat text"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.9",
    "@peculiar/x509": "^2.0.0",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "graphology-shortest-path": "^2.1.0",
    "maxmind": "^5.0.7",
    "minisearch": "^7.2.0",
    "parse5": "^8.0.1",
    "reflect-metadata": "0.2.2",
    "tldts": "^7.4.10",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.1.0",
    "fast-check": "^4.9.0",
    "retire": "^5.4.3",
    "typescript": "^6.0.3"
  }
}
